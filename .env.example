# ── Proxy ─────────────────────────────────────────────────────────────────────
# API key Ghost (or any client) will use to authenticate with this proxy.
# Set the same value in Ghost Admin → Settings → Email → Mailgun API Key.
PROXY_API_KEY=change-me-to-a-random-secret

# Port and host for the proxy server
PORT=3000
HOST=0.0.0.0

# ── SMTP (AWS SES) ─────────────────────────────────────────────────────────────
SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SES_SMTP_USER
SMTP_PASS=YOUR_SES_SMTP_PASSWORD

# ── SES Event Tracking ────────────────────────────────────────────────────────
# Name of the SES Configuration Set you created for event tracking.
# Leave empty to skip event tracking.
SES_CONFIGURATION_SET=infodev-events

# ── Storage ───────────────────────────────────────────────────────────────────
# Path to the SQLite database file for storing events, bounces, unsubscribes.
DB_PATH=./data/events.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
